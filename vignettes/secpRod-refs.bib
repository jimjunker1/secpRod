@article{paineHowFitNonlinear2012,
  title = {How to Fit Nonlinear Plant Growth Models and Calculate Growth Rates: An Update for Ecologists},
  shorttitle = {How to Fit Nonlinear Plant Growth Models and Calculate Growth Rates},
  author = {Paine, C. E. Timothy and Marthews, Toby R. and Vogt, Deborah R. and Purves, Drew and Rees, Mark and Hector, Andy and Turnbull, Lindsay A.},
