  doi = {10.3389/fevo.2023.1188889},
  urldate = {2025-08-25},
  abstract = {Ecogeographical patterns in body size have been described across a wide range of vertebrate species. However, insects have shown inconsistent patterns in studies to date. Aquatic insects, particularly those from remote regions, have barely been explored. The Magellanic sub-Antarctic ecoregion offers an ideal natural laboratory with near pristine environments, limiting the potential influence of confounding variables. In this study we evaluated the influence of elevation on body and wing size, and aspect ratio patterns, for 12 species of mayfly (Ephemeroptera) and stonefly (Plecoptera), along a steep coastal elevation gradient ({\textasciitilde}0-600 m a.s.l.). We detected significant relationships between altitude and morphological features for all studied species. Additionally, we found that in females morphological changes were slightly more pronounced that in males, probably due to their role as dispersers. While body size showed only limited variation along the elevation gradient, there was a notable decrease in wing length over a relatively short geographic distance. Our data suggest that morphological plasticity might be promoted in response to the harsh environmental conditions that typify the steep coastal Magellanic sub-Antarctic mountain ranges.},
  langid = {english},
  keywords = {Body Size,Ecogeographical patterns,Ephemeroptera,Plecoptera,Sub-Antarctic,Wing reduction},
